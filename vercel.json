{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/portal-7890", "destination": "/portal-gcfs-7890.html" },
    { "source": "/portal-gcfs-7890", "destination": "/portal-gcfs-7890.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/services", "destination": "/services.html" },
    { "source": "/loans", "destination": "/services.html" },
    { "source": "/insurance", "destination": "/services.html" },
    { "source": "/calculator", "destination": "/calculator.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/contact-us", "destination": "/contact.html" },
    { "source": "/apply", "destination": "/apply-loan.html" },
    { "source": "/apply-loan", "destination": "/apply-loan.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://www.googletagmanager.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: https: https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://fra.cloud.appwrite.io https://*.appwrite.io https://api.whatsapp.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://freeipapi.com https://ipapi.co https://api.country.is;"
        }
      ]
    },
    {
      "source": "/(portal|admin)(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
